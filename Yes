<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
<title>Wild Duel Online</title>

<script src="https://unpkg.com/peerjs@1.5.5/dist/peerjs.min.js"></script>

<style>
:root{
  --bg:#07070a;
  --panel:#111118;
  --text:#f7f7fb;
  --muted:#9b9bab;
  --red:#ff3b30;
  --blue:#0a84ff;
  --green:#30d158;
  --yellow:#ffd60a;
  --accent:#7c5cff;
}

*{
  box-sizing:border-box;
  -webkit-tap-highlight-color:transparent;
}

body{
  margin:0;
  font-family:system-ui,-apple-system,"Segoe UI",sans-serif;
  background:
    radial-gradient(circle at 15% 10%,rgba(124,92,255,.22),transparent 30%),
    radial-gradient(circle at 85% 90%,rgba(10,132,255,.16),transparent 28%),
    var(--bg);
  color:var(--text);
  min-height:100vh;
}

button,input{
  font:inherit;
}

.app{
  max-width:980px;
  margin:auto;
  padding:16px;
  min-height:100vh;
  display:flex;
  flex-direction:column;
}

.top{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:14px;
}

.brand{
  display:flex;
  align-items:center;
  gap:10px;
}

.logo{
  width:44px;
  height:44px;
  border-radius:14px;
  background:linear-gradient(135deg,#ff3b30,#7c5cff,#0a84ff);
  display:grid;
  place-items:center;
  font-weight:950;
  transform:rotate(-5deg);
}

h1{
  font-size:20px;
  margin:0;
}

.muted{
  color:var(--muted);
  font-size:12px;
}

.screen{
  display:none;
  flex:1;
}

.screen.active{
  display:flex;
  flex-direction:column;
}

.panel{
  margin:auto;
  width:min(100%,560px);
  background:rgba(17,17,24,.92);
  border:1px solid #292936;
  border-radius:26px;
  padding:24px;
  box-shadow:0 25px 80px rgba(0,0,0,.45);
}

.panel h2{
  font-size:32px;
  margin:0 0 8px;
}

.panel p{
  color:var(--muted);
  line-height:1.45;
}

.field{
  margin:14px 0;
}

.field label{
  display:block;
  font-size:13px;
  color:#c9c9d2;
  margin-bottom:7px;
}

.field input{
  width:100%;
  padding:14px 15px;
  border-radius:14px;
  border:1px solid #2b2b37;
  background:#0d0d13;
  color:#fff;
}

.row{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
}

.btn{
  border:0;
  border-radius:14px;
  padding:14px 16px;
  font-weight:800;
  cursor:pointer;
}

.primary{
  background:linear-gradient(135deg,#7c5cff,#4f8cff);
  color:white;
}

.secondary{
  background:#191923;
  border:1px solid #30303c;
  color:white;
}

.statusbox{
  background:#0d0d13;
  border:1px solid #2b2b37;
  padding:12px 14px;
  border-radius:14px;
  margin-top:12px;
  font-size:13px;
  color:#d5d5df;
}

.share{
  display:none;
  margin-top:14px;
}

.share.show{
  display:block;
}

.code{
  font-size:30px;
  font-weight:950;
  letter-spacing:.16em;
  background:#0b0b10;
  border:1px dashed #45455a;
  padding:14px;
  border-radius:16px;
  text-align:center;
}

.players{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
}

.player{
  background:rgba(17,17,24,.9);
  border:1px solid #252531;
  border-radius:18px;
  padding:12px 14px;
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.player.active{
  border-color:#7c5cff;
}

.pill{
  font-size:10px;
  padding:6px 8px;
  border-radius:99px;
  background:#252532;
  color:#bbb;
}

.player.active .pill{
  background:#7c5cff;
  color:#fff;
}

.table{
  flex:1;
  min-height:390px;
  background:linear-gradient(180deg,rgba(18,18,28,.92),rgba(12,12,18,.92));
  border:1px solid #242430;
  border-radius:26px;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  position:relative;
  padding:22px;
  margin:12px 0;
}

.gamestatus{
  position:absolute;
  top:14px;
  left:14px;
  right:14px;
  text-align:center;
  color:#d5d5df;
  font-size:13px;
}

.pilearea{
  display:flex;
  gap:28px;
  align-items:center;
}

.pilelabel{
  text-align:center;
  font-size:12px;
  color:var(--muted);
  margin-top:8px;
}

.card{
  width:110px;
  height:162px;
  border-radius:18px;
  border:5px solid rgba(255,255,255,.92);
  box-shadow:0 14px 30px rgba(0,0,0,.35);
  display:grid;
  place-items:center;
  position:relative;
  font-weight:950;
  user-select:none;
}

.oval{
  width:75%;
  height:62%;
  border-radius:50%;
  background:rgba(255,255,255,.93);
  display:grid;
  place-items:center;
  transform:rotate(-22deg);
  color:#111;
}

.val{
  font-size:36px;
  transform:rotate(22deg);
}

.corner{
  position:absolute;
  font-size:16px;
}

.tl{
  top:8px;
  left:9px;
}

.br{
  right:9px;
  bottom:8px;
  transform:rotate(180deg);
}

.red{background:var(--red)}
.blue{background:var(--blue)}
.green{background:var(--green)}
.yellow{background:var(--yellow);color:#111}

.wild{
  background:
    conic-gradient(
      from 45deg,
      #ff3b30 0 25%,
      #0a84ff 25% 50%,
      #30d158 50% 75%,
      #ffd60a 75%
    );
}

.back{
  background:linear-gradient(135deg,#15151d,#232332);
}

.back .oval{
  background:linear-gradient(135deg,#ff3b30,#7c5cff,#0a84ff);
  color:white;
}

.back .val{
  font-size:19px;
  line-height:1.05;
  text-align:center;
}

.drawpile{
  cursor:pointer;
}

.handbox{
  background:rgba(17,17,24,.92);
  border:1px solid #252531;
  border-radius:22px;
  padding:13px;
}

.handtop{
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.hand{
  display:flex;
  gap:8px;
  overflow-x:auto;
  padding:9px 2px 10px;
}

.hand .card{
  min-width:74px;
  width:74px;
  height:108px;
  border-width:4px;
  border-radius:13px;
  cursor:pointer;
}

.hand .val{
  font-size:25px;
}

.hand .corner{
  font-size:11px;
}

.hand .card.playable{
  transform:translateY(-4px);
  box-shadow:
    0 15px 26px rgba(0,0,0,.35),
    0 0 0 2px rgba(255,255,255,.08);
}

.hand .card:not(.playable){
  filter:saturate(.6) brightness(.62);
}

.penalty{
  position:absolute;
  bottom:14px;
  background:#2b1632;
  border:1px solid #683077;
  color:#f3cbff;
  padding:9px 12px;
  border-radius:99px;
  font-size:12px;
  display:none;
}

.penalty.show{
  display:block;
}

.overlay{
  position:fixed;
  inset:0;
  background:rgba(4,4,8,.88);
  backdrop-filter:blur(15px);
  z-index:20;
  display:none;
  align-items:center;
  justify-content:center;
  padding:22px;
}

.overlay.show{
  display:flex;
}

.modal{
  width:min(100%,450px);
  background:#12121a;
  border:1px solid #2a2a36;
  border-radius:24px;
  padding:24px;
  text-align:center;
}

.colorgrid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
}

.colorbtn{
  height:75px;
  border:0;
  border-radius:17px;
  font-weight:900;
  color:white;
}

.colorbtn.yellow{
  color:#111;
}

.toast{
  position:fixed;
  left:50%;
  bottom:24px;
  transform:translate(-50%,20px);
  background:white;
  color:#111;
  padding:10px 15px;
  border-radius:99px;
  font-weight:800;
  font-size:13px;
  opacity:0;
  transition:.2s;
  z-index:40;
}

.toast.show{
  opacity:1;
  transform:translate(-50%,0);
}

@media(max-width:640px){
  .app{padding:11px}
  .panel{padding:20px}
  .panel h2{font-size:28px}
  .table{min-height:350px}
  .card{width:94px;height:140px}
  .pilearea{gap:18px}
  .hand .card{min-width:68px;width:68px;height:100px}
  .row{grid-template-columns:1fr}
}
</style>
</head>

<body>

<div class="app">

<div class="top">
  <div class="brand">
    <div class="logo">WD</div>

    <div>
      <h1>Wild Duel Online</h1>
      <div class="muted">live 2-player chaos</div>
    </div>
  </div>

  <button class="btn secondary" id="leaveBtn" style="display:none">
    Leave
  </button>
</div>

<section id="lobby" class="screen active">

<div class="panel">

<h2>Battle from two phones.</h2>

<p>
Create a room and send the code or invite link to your girlfriend.
Every match is freshly shuffled and the starting player is random.
</p>

<div class="field">
<label>Your name</label>
<input id="myName" maxlength="18" value="Player 1">
</div>

<div class="row">
<button class="btn primary" id="hostBtn">
Create Room
</button>

<button class="btn secondary" id="showJoinBtn">
Join Room
</button>
</div>

<div id="joinArea" style="display:none">

<div class="field">
<label>Room code</label>
<input id="roomInput" maxlength="10" placeholder="ABC123">
</div>

<button class="btn primary" id="joinBtn" style="width:100%">
Join Game
</button>

</div>

<div id="shareArea" class="share">

<div class="muted">
ROOM CODE
</div>

<div class="code" id="roomCode">
------
</div>

<div class="row" style="margin-top:10px">

<button class="btn secondary" id="copyCode">
Copy Code
</button>

<button class="btn secondary" id="copyLink">
Copy Invite Link
</button>

</div>
</div>

<div class="statusbox" id="netStatus">
Ready to connect.
</div>

</div>
</section>

<section id="game" class="screen">

<div class="players">

<div class="player" id="p0">
<div>
<b id="n0">Player 1</b>
<div class="muted">
<span id="c0">7</span> cards
</div>
</div>
<span class="pill">WAITING</span>
</div>

<div class="player" id="p1">
<div>
<b id="n1">Player 2</b>
<div class="muted">
<span id="c1">7</span> cards
</div>
</div>
<span class="pill">WAITING</span>
</div>

</div>

<div class="table">

<div class="gamestatus" id="gameStatus"></div>

<div class="pilearea">

<div>

<div id="drawPile" class="card back drawpile">

<div class="oval">
<div class="val">
WILD<br>DUEL
</div>
</div>

</div>

<div class="pilelabel">
Tap to draw
</div>

</div>

<div>

<div id="discard"></div>

<div class="pilelabel">
Discard
</div>

</div>

</div>

<div class="penalty" id="penalty"></div>

</div>

<div class="handbox">

<div class="handtop">

<b>Your hand</b>

<span class="muted" id="hint"></span>

</div>

<div class="hand" id="hand"></div>

</div>

</section>

</div>

<div class="overlay" id="colorOverlay">

<div class="modal">

<h2>Choose a color</h2>

<p class="muted">
This becomes the active color.
</p>

<div class="colorgrid">

<button class="colorbtn red" data-color="red">
Red
</button>

<button class="colorbtn blue" data-color="blue">
Blue
</button>

<button class="colorbtn green" data-color="green">
Green
</button>

<button class="colorbtn yellow" data-color="yellow">
Yellow
</button>

</div>
</div>
</div>

<div class="overlay" id="winOverlay">

<div class="modal">

<div style="font-size:54px">
🏆
</div>

<h2 id="winTitle">
Winner!
</h2>

<p class="muted">
Absolute chaos.
</p>

<button class="btn primary" id="rematchBtn" style="width:100%">
Rematch
</button>

</div>
</div>

<div class="toast" id="toast"></div>

<script>

const $ = id => document.getElementById(id);

const colors = [
  "red",
  "blue",
  "green",
  "yellow"
];

let peer = null;
let conn = null;
let isHost = false;
let myIndex = null;
let pendingWildIndex = null;
let state = null;

function rand(n){
  return Math.floor(Math.random() * n);
}

function shuffle(a){

  for(let i = a.length - 1; i > 0; i--){

    const j = rand(i + 1);

    [a[i],a[j]] = [a[j],a[i]];

  }

  return a;
}

function roomCode(){

  const chars =
  "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";

  let s = "";

  for(let i = 0; i < 6; i++){

    s += chars[rand(chars.length)];

  }

  return s;
}

function makeDeck(){

  const d = [];

  for(const c of colors){

    for(let n = 0; n <= 9; n++){

      d.push({
        color:c,
        type:"num",
        value:String(n)
      });

      if(n !== 0){

        d.push({
          color:c,
          type:"num",
          value:String(n)
        });

      }

    }

    for(let i = 0; i < 4; i++){

      d.push({
        color:c,
        type:"skip",
        value:"⊘"
      });

      d.push({
        color:c,
        type:"reverse",
        value:"↺"
      });

      d.push({
        color:c,
        type:"draw2",
        value:"+2"
      });

    }

  }

  for(let i = 0; i < 8; i++){

    d.push({
      color:"wild",
      type:"wild",
      value:"W"
    });

  }

  for(let i = 0; i < 10; i++){

    d.push({
      color:"wild",
      type:"wild4",
      value:"+4"
    });

  }

  return shuffle(d);
}

function newState(a,b){

  const s = {

    players:[a,b],

    hands:[
      [],
      []
    ],

    deck:makeDeck(),

    discard:[],

    turn:rand(2),

    currentColor:null,

    pendingDraw:0,

    pendingType:null,

    winner:null,

    drawnThisTurn:false

  };

  for(let i = 0; i < 7; i++){

    s.hands[0].push(
      s.deck.pop()
    );

    s.hands[1].push(
      s.deck.pop()
    );

  }

  let first;

  do{

    first = s.deck.pop();

    if(first.type !== "num"){
      s.deck.unshift(first);
    }

  }
  while(first.type !== "num");

  s.discard.push(first);

  s.currentColor = first.color;

  return s;
}

function topCard(){

  return state.discard[
    state.discard.length - 1
  ];

}

function canPlay(card){

  if(state.pendingDraw > 0){

    return card.type ===
      state.pendingType;

  }

  const t = topCard();

  return (
    card.color === "wild" ||
    card.color === state.currentColor ||
    card.type === t.type ||
    (
      card.type === "num" &&
      t.type === "num" &&
      card.value === t.value
    )
  );

}

function cardHTML(card,idx=null){

  const play =
    idx !== null &&
    state.turn === myIndex &&
    canPlay(card);

  const display =
    card.type === "wild"
      ? "WILD"
      : card.value;

  return `
  <div
  class="card ${card.color} ${play ? "playable" : ""}"
  ${idx !== null ? `data-idx="${idx}"` : ""}
  >

  <span class="corner tl">
  ${display}
  </span>

  <div class="oval">
  <div class="val">
  ${display}
  </div>
  </div>

  <span class="corner br">
  ${display}
  </span>

  </div>
  `;

}

function viewFor(player){

  const v =
  JSON.parse(
    JSON.stringify(state)
  );

  v.hands[1-player] =
    Array(
      state.hands[1-player].length
    ).fill(null);

  v.deck =
    Array(state.deck.length)
    .fill(null);

  return v;
}

function sendState(){

  if(
    isHost &&
    conn &&
    conn.open
  ){

    conn.send({

      type:"state",

      state:viewFor(1)

    });

  }

}

function toastMsg(m){

  $("toast").textContent = m;

  $("toast").classList.add(
    "show"
  );

  clearTimeout(window.tt);

  window.tt =
    setTimeout(
      () =>
      $("toast")
      .classList
      .remove("show"),
      1500
    );

}

function reshuffle(){

  if(
    state.deck.length === 0 &&
    state.discard.length > 1
  ){

    const t =
      state.discard.pop();

    state.deck =
      shuffle(
        state.discard.splice(0)
      );

    state.discard = [t];

  }

}

function drawFor(player,n){

  for(let i = 0; i < n; i++){

    reshuffle();

    if(state.deck.length){

      state.hands[player]
      .push(
        state.deck.pop()
      );

    }

  }

}

function render(){

  if(!state){
    return;
  }

  $("lobby")
  .classList
  .remove("active");

  $("game")
  .classList
  .add("active");

  $("leaveBtn")
  .style
  .display = "block";

  $("n0").textContent =
    state.players[0];

  $("n1").textContent =
    state.players[1];

  $("c0").textContent =
    state.hands[0].length;

  $("c1").textContent =
    state.hands[1].length;

  [0,1].forEach(i => {

    const el =
      $("p" + i);

    el.classList.toggle(
      "active",
      state.turn === i &&
      !state.winner
    );

    el.querySelector(
      ".pill"
    ).textContent =
      state.turn === i &&
      !state.winner
        ? "TURN"
        : "WAITING";

  });

  $("discard").innerHTML =
    cardHTML(
      topCard()
    );

  const mine =
    state.hands[myIndex] || [];

  $("hand").innerHTML =
    mine
    .map(
      (c,i) =>
      cardHTML(c,i)
    )
    .join("");

  document
  .querySelectorAll(
    "#hand .card"
  )
  .forEach(
    el =>
    el.onclick =
    () =>
    attemptPlay(
      +el.dataset.idx
    )
  );

  const myTurn =
    state.turn === myIndex &&
    !state.winner;

  const playable =
    mine.some(canPlay);

  $("hint").textContent =
    !myTurn
      ? "Opponent is playing"
      :
      state.pendingDraw > 0
      ?
      `Stack ${
        state.pendingType ===
        "draw2"
        ? "+2"
        : "+4"
      } or draw ${
        state.pendingDraw
      }`
      :
      playable
      ?
      "Tap a glowing card"
      :
      "Draw a card";

  $("gameStatus").innerHTML =
    state.winner !== null
    ?
    `<strong>${
      state.players[
        state.winner
      ]
    }</strong> wins!`
    :
    myTurn
    ?
    `<strong>Your turn</strong>
    • Active color:
    <strong>${
      state.currentColor
    }</strong>`
    :
    `<strong>${
      state.players[
        state.turn
      ]
    }</strong> is playing
    • Active color:
    <strong>${
      state.currentColor
    }</strong>`;

  $("penalty")
  .classList
  .toggle(
    "show",
    state.pendingDraw > 0
  );

  $("penalty")
  .textContent =
    state.pendingDraw > 0
      ?
      `Penalty waiting:
      +${state.pendingDraw}`
      :
      "";

  if(state.winner !== null){

    $("winTitle")
    .textContent =
      state.players[
        state.winner
      ] + " wins!";

    $("winOverlay")
    .classList
    .add("show");

  }

}

function request(action){

  if(isHost){

    handleAction(
      myIndex,
      action
    );

  }
  else if(
    conn &&
    conn.open
  ){

    conn.send({
      type:"action",
      player:myIndex,
      action
    });

  }

}

function attemptPlay(idx){

  if(
    !state ||
    state.turn !== myIndex
  ){

    return toastMsg(
      "Not your turn"
    );

  }

  const card =
    state.hands[
      myIndex
    ][idx];

  if(!canPlay(card)){

    return toastMsg(
      "That card can't be played"
    );

  }

  if(
    card.color === "wild"
  ){

    pendingWildIndex =
      idx;

    $("colorOverlay")
    .classList
    .add("show");

    return;

  }

  request({
    kind:"play",
    idx
  });

}

$("drawPile").onclick =
() => {

  if(
    !state ||
    state.turn !== myIndex
  ){

    return toastMsg(
      "Not your turn"
    );

  }

  request({
    kind:"draw"
  });

};

function handleAction(
  player,
  a
){

  if(!state){
    return;
  }

  if(
    a.kind === "rematch"
  ){

    state =
      newState(
        state.players[0],
        state.players[1]
      );

    $("winOverlay")
    .classList
    .remove("show");

    sendState();
    render();

    return;
  }

  if(
    state.winner !== null ||
    player !== state.turn
  ){

    return;
  }

  if(
    a.kind === "play"
  ){

    const card =
      state.hands[
        player
      ][a.idx];

    if(
      !card ||
      !canPlay(card)
    ){

      return;
    }

    state.hands[
      player
    ].splice(
      a.idx,
      1
    );

    state.discard.push(
      card
    );

    if(
      card.color !== "wild"
    ){

      state.currentColor =
        card.color;

    }

    if(
      card.type === "draw2"
    ){

      state.pendingDraw += 2;

      state.pendingType =
        "draw2";

    }

    if(
      card.type === "wild4"
    ){

      state.pendingDraw += 4;

      state.pendingType =
        "wild4";

    }

    if(
      a.color &&
      card.color === "wild"
    ){

      state.currentColor =
        a.color;

    }

    if(
      state.hands[player]
      .length === 0
    ){

      state.winner =
        player;

    }
    else if(
      card.type !== "skip" &&
      card.type !== "reverse"
    ){

      state.turn =
        1 - state.turn;

      state.drawnThisTurn =
        false;

    }
    else{

      state.drawnThisTurn =
        false;

      toastMsg(
        "Skip! Same player goes again."
      );

    }

  }

  else if(
    a.kind === "draw"
  ){

    if(
      state.drawnThisTurn
    ){
      return;
    }

    if(
      state.pendingDraw > 0
    ){

      drawFor(
        player,
        state.pendingDraw
      );

      state.pendingDraw = 0;

      state.pendingType = null;

      state.turn =
        1 - state.turn;

      state.drawnThisTurn =
        false;

    }
    else{

      drawFor(
        player,
        1
      );

      const drawn =
        state.hands[
          player
        ][
          state.hands[
            player
          ].length - 1
        ];

      if(
        canPlay(drawn)
      ){

        state.drawnThisTurn =
          true;

      }
      else{

        state.turn =
          1 - state.turn;

        state.drawnThisTurn =
          false;

      }

    }

  }

  sendState();
  render();

}

function setupConn(c){

  conn = c;

  c.on(
    "open",
    () => {

      setStatus(
        "Connected. Starting game..."
      );

      if(isHost){

        state =
          newState(
            (
              $("myName").value ||
              "Player 1"
            ).trim(),
            "Player 2"
          );

        myIndex = 0;

        c.send({
          type:"hello",
          hostName:
            state.players[0]
        });

      }

    }
  );

  c.on(
    "data",
    d => {

      if(
        d.type === "hello" &&
        !isHost
      ){

        myIndex = 1;

        conn.send({

          type:"joinName",

          name:
          (
            $("myName").value ||
            "Player 2"
          ).trim()

        });

      }

      else if(
        d.type === "joinName" &&
        isHost
      ){

        state.players[1] =
          d.name ||
          "Player 2";

        sendState();
        render();

      }

      else if(
        d.type === "state" &&
        !isHost
      ){

        state =
          d.state;

        render();

      }

      else if(
        d.type === "action" &&
        isHost
      ){

        handleAction(
          d.player,
          d.action
        );

      }

    }
  );

  c.on(
    "close",
    () => {

      setStatus(
        "Other player disconnected."
      );

      toastMsg(
        "Connection closed"
      );

    }
  );

  c.on(
    "error",
    () =>
    setStatus(
      "Connection error. Try reconnecting."
    )
  );

}

function setStatus(t){

  $("netStatus")
  .textContent = t;

}

$("hostBtn").onclick =
() => {

  isHost = true;

  myIndex = 0;

  const code =
    roomCode();

  $("roomCode")
  .textContent =
    code;

  $("shareArea")
  .classList
  .add("show");

  setStatus(
    "Creating room..."
  );

  peer =
    new Peer(
      "wildduel-" +
      code.toLowerCase()
    );

  peer.on(
    "open",
    () =>
    setStatus(
      "Room ready. Send the code or invite link."
    )
  );

  peer.on(
    "connection",
    c => {

      if(
        conn &&
        conn.open
      ){

        c.close();

        return;
      }

      setupConn(c);

    }
  );

  peer.on(
    "error",
    e =>
    setStatus(
      "Could not create room: " +
      e.type
    )
  );

};

$("showJoinBtn").onclick =
() => {

  $("joinArea")
  .style
  .display =
    "block";

  $("shareArea")
  .classList
  .remove("show");

};

$("joinBtn").onclick =
() => {

  isHost = false;

  myIndex = 1;

  const code =
    $("roomInput")
    .value
    .trim()
    .toLowerCase();

  if(!code){
    return;
  }

  setStatus(
    "Connecting..."
  );

  peer =
    new Peer();

  peer.on(
    "open",
    () =>
    setupConn(
      peer.connect(
        "wildduel-" + code,
        {
          reliable:true
        }
      )
    )
  );

  peer.on(
    "error",
    e =>
    setStatus(
      "Could not connect: " +
      e.type
    )
  );

};

$("copyCode").onclick =
async () => {

  await navigator.clipboard.writeText(
    $("roomCode").textContent
  );

  toastMsg(
    "Room code copied"
  );

};

$("copyLink").onclick =
async () => {

  const u =
    new URL(
      location.href
    );

  u.searchParams.set(
    "room",
    $("roomCode").textContent
  );

  await navigator.clipboard.writeText(
    u.toString()
  );

  toastMsg(
    "Invite link copied"
  );

};

$("leaveBtn").onclick =
() => location.reload();

$("rematchBtn").onclick =
() =>
request({
  kind:"rematch"
});

document
.querySelectorAll(
  ".colorbtn"
)
.forEach(
  b =>
  b.onclick =
  () => {

    const idx =
      pendingWildIndex;

    pendingWildIndex =
      null;

    $("colorOverlay")
    .classList
    .remove("show");

    request({
      kind:"play",
      idx,
      color:
        b.dataset.color
    });

  }
);

const q =
new URLSearchParams(
  location.search
)
.get("room");

if(q){

  $("showJoinBtn").click();

  $("roomInput").value =
    q;

}

</script>

</body>
</html>
